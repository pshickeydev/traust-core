#!/usr/bin/env bash
# Full lint + unit tests with the coverage gate (same as CI). Bypass: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
command -v uv >/dev/null 2>&1 || { echo "pre-push: uv not found — install uv, then run: make setup" >&2; exit 1; }
make lint
make coverage
